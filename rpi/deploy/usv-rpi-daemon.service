[Unit]
Description=USV-AM RPi4 daemon (ponte UART ESP32 <-> Firebase RTDB)
Documentation=file:///home/vandrekad/aruatech/rpi/README.md
# So sobe apos a rede estar pronta (Firebase precisa de conectividade)
After=network-online.target
Wants=network-online.target
# StartLimit* vão em [Unit] (systemd >= v230). Evita loop de crash apertado:
# 5 falhas em 60s => para e espera intervencao manual.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=vandrekad
WorkingDirectory=/home/vandrekad/aruatech/rpi

# Ajuste os caminhos/URL conforme o seu setup (F0 item 0.4 gera o serviceAccount.json)
# --port é OMITIDO de propósito: o daemon autodetecta qual /dev/ttyUSB* é o ESP32
# sondando o protocolo (resolve a oscilacao ttyUSB0<->ttyUSB1). Para forçar uma
# porta, acrescente "--port /dev/ttyUSBx" — ainda assim a autodeteccao corrige se mudar.
ExecStart=/home/vandrekad/aruatech/rpi/.venv/bin/python \
    /home/vandrekad/aruatech/rpi/rpi_daemon.py \
    --service-account /home/vandrekad/serviceAccount.json \
    --database-url https://usvs-drone-fluvial-autonomo-default-rtdb.firebaseio.com/ \
    --drone-id drone_01

# Resiliencia: reinicia sempre que cair, com backoff.
Restart=always
RestartSec=3

# Logs vao para o journald (stdout/stderr). Rotacao pelo journald (ver README).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=usv-rpi-daemon

# Endurecimento leve (o daemon so precisa da UART, rede e do proprio diretorio)
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/vandrekad/aruatech/rpi
# UART precisa do grupo dialout (usuario pi ja costuma estar nele)
SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
