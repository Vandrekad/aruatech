# ─────────────────────────────────────────────────────────────────────────
# Portainer stack environment for the AruaTech USV-AM Dashboard (frontend).
# Paste these into the Portainer stack's "Environment variables" panel.
#
# NOTE: The Firebase VITE_* config is NOT here — it is baked into the image at
# BUILD time by GitHub Actions (Vite inlines import.meta.env.VITE_* into the
# bundle). Set those as repo secrets/vars (see below), not as stack env.
# ─────────────────────────────────────────────────────────────────────────

# GHCR image published by .github/workflows/deploy.yml.
IMAGE_BASE=ghcr.io/vandrekad/usv-frontend
IMAGE_TAG=latest

# Public hostname routed by the external Traefik (letsencryptresolver).
FRONTEND_DOMAIN=usv.automakad.com.br

# ─────────────────────────────────────────────────────────────────────────
# BUILD-TIME Firebase config — set these as GitHub Actions repository SECRETS
# (Settings → Secrets and variables → Actions), NOT in this stack:
#
#   VITE_FIREBASE_API_KEY
#   VITE_FIREBASE_AUTH_DOMAIN
#   VITE_FIREBASE_DATABASE_URL
#   VITE_FIREBASE_PROJECT_ID
#   VITE_FIREBASE_STORAGE_BUCKET
#   VITE_FIREBASE_MESSAGING_SENDER_ID
#   VITE_FIREBASE_APP_ID
#
# And optionally a repo VARIABLE:
#   FRONTEND_DOMAIN (used only for documentation/labels; the deploy webhook
#                    below triggers Portainer to pull the freshly built image)
#
# Repo SECRET for auto-redeploy:
#   PORTAINER_WEBHOOK_URL  (the stack's Portainer webhook; optional)
# ─────────────────────────────────────────────────────────────────────────
